# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/

# wrangler 的本地状态：dev 跑起来的 workerd 缓存、上传清单、遥测标记。
# 不是配置（配置是 apps/*/wrangler.jsonc，那两份要进库），是运行痕迹。
.wrangler/

# pdfjs-dist 的 worker/cmaps/字体，由 scripts/copy-pdfjs.mjs 复制进来
apps/*/public/pdfjs/

# verify/lighthouse.mjs 每次跑都会重写这份报告 —— 是测量结果不是源码，
# 而且里面的毫秒数随机器负载浮动，进了库只会制造无意义的 diff
verify/lighthouse-report.json
