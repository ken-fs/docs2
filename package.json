{
  "name": "document-tools",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "dev:md": "pnpm --filter docstomd dev",
    "build:md": "pnpm --filter docstomd build",
    "test:md": "pnpm --filter docstomd test",
    "dev:html": "pnpm --filter docs2html dev",
    "build:html": "pnpm --filter docs2html build",
    "test:html": "pnpm --filter docs2html test",
    "deploy:md": "pnpm --filter docstomd build && wrangler deploy --config apps/docstomd/wrangler.jsonc",
    "deploy:html": "pnpm --filter docs2html build && wrangler deploy --config apps/docs2html/wrangler.jsonc",
    "verify:cross": "node verify/cross-site.mjs",
    "verify:perf": "node verify/lighthouse.mjs",
    "verify:browsers": "node verify/browsers.mjs",
    "verify:i18n": "node verify/i18n.mjs",
    "verify:contrast": "node verify/contrast.mjs",
    "verify:color": "node verify/color.mjs"
  },
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "wrangler": "4.119.0"
  }
}
